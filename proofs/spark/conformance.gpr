project Conformance is
   --  Intentionally EXCLUDED from edgewalk_spark.gpr proof scope.
   for Languages use ("Ada");
   for Source_Dirs use ("src", "conformance");
   for Object_Dir use "obj-conformance";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("conformance_driver.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-gnatwe");
   end Compiler;
end Conformance;
